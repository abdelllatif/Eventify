{
  "info": {
    "name": "Eventify API Collection",
    "description": "Postman collection to test all Eventify REST endpoints. Uses Basic Auth for protected routes. Set environment variables: baseUrl, username, password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "user@example.com" },
    { "key": "password", "value": "password" }
  ],
  "item": [
    {
      "name": "Public",
      "description": "Endpoints that do not require authentication.",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/public/users",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "public", "users" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "List Public Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/events",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "public", "events" ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Authentication endpoints (Basic Auth required).",
      "auth": {
        "type": "basic",
        "basic": [
          { "key": "username", "value": "{{username}}", "type": "string" },
          { "key": "password", "value": "{{password}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Login (Basic Auth)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "login" ]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "description": "Endpoints for users (ROLE_USER). Use Basic Auth.",
      "auth": {
        "type": "basic",
        "basic": [
          { "key": "username", "value": "{{username}}", "type": "string" },
          { "key": "password", "value": "{{password}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user/profile",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "user", "profile" ]
            }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/user/profile",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "user", "profile" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\"\n}"
            }
          }
        },
        {
          "name": "Register To Event",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/user/events/:eventId/register",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "user", "events", ":eventId", "register" ],
              "variable": [ { "key": "eventId", "value": "REPLACE_WITH_EVENT_ID" } ]
            }
          }
        },
        {
          "name": "My Registrations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user/registrations",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "user", "registrations" ]
            }
          }
        },
        {
          "name": "Cancel Registration",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/user/registrations/:registrationId",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "user", "registrations", ":registrationId" ],
              "variable": [ { "key": "registrationId", "value": "REPLACE_WITH_REGISTRATION_ID" } ]
            }
          }
        }
      ]
    },
    {
      "name": "Organizer",
      "description": "Endpoints for organizers (ROLE_ORGANIZER). Use Basic Auth.",
      "auth": {
        "type": "basic",
        "basic": [
          { "key": "username", "value": "{{username}}", "type": "string" },
          { "key": "password", "value": "{{password}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/organizer/events",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "organizer", "events" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tech Conference\",\n  \"description\": \"Annual tech conference\",\n  \"location\": \"New York\",\n  \"dateTime\": \"2030-01-01T10:00:00\",\n  \"capacity\": 200\n}"
            }
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/organizer/events/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "organizer", "events", ":id" ],
              "variable": [ { "key": "id", "value": "REPLACE_WITH_EVENT_ID" } ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"description\": \"Updated description\",\n  \"location\": \"Los Angeles\",\n  \"dateTime\": \"2030-02-01T09:00:00\",\n  \"capacity\": 150\n}"
            }
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/organizer/events/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "organizer", "events", ":id" ],
              "variable": [ { "key": "id", "value": "REPLACE_WITH_EVENT_ID" } ]
            }
          }
        },
        {
          "name": "Event Participants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/organizer/events/:eventId/participants",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "organizer", "events", ":eventId", "participants" ],
              "variable": [ { "key": "eventId", "value": "REPLACE_WITH_EVENT_ID" } ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Endpoints for admins (ROLE_ADMIN). Use Basic Auth.",
      "auth": {
        "type": "basic",
        "basic": [
          { "key": "username", "value": "{{username}}", "type": "string" },
          { "key": "password", "value": "{{password}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "admin", "users" ]
            }
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/:id/role",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "admin", "users", ":id", "role" ],
              "variable": [ { "key": "id", "value": "REPLACE_WITH_USER_ID" } ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}"
            }
          }
        },
        {
          "name": "Delete Event (Admin)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/admin/events/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "admin", "events", ":id" ],
              "variable": [ { "key": "id", "value": "REPLACE_WITH_EVENT_ID" } ]
            }
          }
        }
      ]
    }
  ]
}
